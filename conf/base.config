/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    wf-paired-end-illumina-assembly Nextflow base config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    // Standard defaults for all processes
    cpus              = { check_max( 1    * task.attempt, 'cpus'     ) }
    memory            = { check_max( 6.GB * task.attempt, 'memory'   ) }
    time              = { check_max( 4.h  * task.attempt, 'time'     ) }

    errorStrategy     = { task.exitStatus in [71,104,134,137,139,140,143,255] ? 'retry' : 'finish' }
    maxRetries        = 3
    maxErrors         = '-1'

    // Process-specific resource requirements
    withLabel:process_single {
        cpus          = { check_max( 1                  , 'cpus'     ) }
        memory        = { check_max( 6.GB * task.attempt, 'memory'   ) }
        time          = { check_max( 4.h  * task.attempt, 'time'     ) }
    }
    withLabel:process_low {
        cpus          = { check_max( 2     * task.attempt, 'cpus'    ) }
        memory        = { check_max( 12.GB * task.attempt, 'memory'  ) }
        time          = { check_max( 4.h   * task.attempt, 'time'    ) }
    }
    withLabel:process_medium {
        cpus          = { check_max( 6     * task.attempt, 'cpus'    ) }
        memory        = { check_max( 36.GB * task.attempt, 'memory'  ) }
        time          = { check_max( 4.h   * task.attempt, 'time'    ) }
    }
    withLabel:process_high {
        cpus          = { check_max( 12    * task.attempt, 'cpus'    ) }
        memory        = { check_max( 72.GB * task.attempt, 'memory'  ) }
        time          = { check_max( 8.h   * task.attempt, 'time'     ) }
    }
    withLabel:process_long {
        time          = { check_max( 96.h  * task.attempt, 'time'    ) }
    }
    withLabel:process_high_memory {
        memory        = { check_max( 200.GB * task.attempt, 'memory' ) }
    }
    withLabel:error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel:error_retry {
        errorStrategy = 'retry'
        maxRetries    = 3
    }
}

/*
// Function to adjust resources based on exit codes and attempts
def adjust_resources(base_value, resource_type) {
    if (task.attempt == 1) {
        return base_value  // Keep first attempt default
    }

    def scale_factor = 1.0

    switch (task.exitStatus) {
        case 71:  // I/O Error (Often due to memory)
            if (resource_type == 'memory') return base_value * 1.5

        case 134: // Aborted (OOM-related in many cases)
            if (resource_type == 'memory') return base_value * 1.5

        case 137: // Killed (OOM issue)
            if (resource_type == 'memory') return base_value * 1.5

        case 139: // Segmentation fault (Memory issue)
            if (resource_type == 'memory') return base_value * 1.5

        case 140: // Bus error (Memory issue)
            if (resource_type == 'memory') return base_value * 1.5

        case 143: // Time limit exceeded (SIGTERM)
            if (resource_type == 'time') return base_value * 1.5

        case 104: // Unknown error (moderate bump in CPU & Memory)
            if (resource_type == 'cpu' || resource_type == 'memory') return base_value * 1.2

        case 255: // Application-specific error (generic, moderate bump)
            if (resource_type == 'cpu' || resource_type == 'memory') return base_value * 1.2

        // Extras -- unused so far
        case 124: // Timeout (SIGXCPU, process exceeded allowed time)
            if (resource_type == 'time') return base_value * 1.5

        case 125: // Command failure (low CPU issue potential)
            if (resource_type == 'cpu') return base_value * 1.2

        case 126: // Permission denied (not resource-related)
            return base_value  // No change

        case 127: // Command not found (not resource-related)
            return base_value  // No change

        case 1:   // General error (might be memory/CPU-related)
            if (resource_type == 'cpu' || resource_type == 'memory') return base_value * 1.2
    }

    return base_value  // Default if no case matches
}
*/

/*
Exit_Code	Meaning	Adjustment
71	Out of memory (I/O error)	Increase memory
104	Unknown error	Increase both CPU & memory slightly
134	Aborted (SIGABRT): Likely memory issue	Increase memory
137	Killed (SIGKILL): Almost always OOM (Out of Memory)	Increase memory significantly
139	Segmentation fault (SIGSEGV): Memory issue	Increase memory
140	Bus error: Likely memory issue	Increase memory
143	Terminated (SIGTERM): Often runtime exceeded	Increase time
255	Application-specific error (generic)	Increase both CPU & memory slightly
*/
